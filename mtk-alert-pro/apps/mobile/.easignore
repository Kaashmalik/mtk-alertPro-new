# Node modules (EAS installs fresh)
node_modules/
**/node_modules/

# Expo caches
.expo/
.expo-shared/

# Native folders (EAS generates these)
ios/
android/

# Lock files — MUST be uploaded so EAS installs the exact same dependency
# tree as local dev (excluding them makes builds non-reproducible).

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# Temp files
.tmp/
.temp/
*.tmp
*.temp

# Test & build artifacts
coverage/
dist/
build/
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Git
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# Documentation (not needed in app)
docs/
*.md
!README.md

# Monorepo root files (we're in apps/mobile)
../../node_modules/
../../packages/
../../docs/
../../.git/
../../pruned/

# Secrets — must never be uploaded to EAS or baked into a build
.env
.env.*
!.env.example

# Large unnecessary files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Source maps (built fresh)
*.map

# Additional exclusions for faster upload
*.txt
*.docx
*.xlsx
*.pptx
*.pdf
*.gif
*.svg
*.ico
*.webp
*.mp4
*.mov
*.avi
*.mkv
*.flac

# Media under src/ is not needed for the build
src/**/*.jpg
src/**/*.jpeg
src/**/*.png
src/**/*.mp3
src/**/*.wav

# CRITICAL: app.json references assets/icon.png, assets/splash.png,
# assets/adaptive-icon.png, assets/notification-icon.png and
# assets/favicon.png, and expo-notifications needs assets/sounds/.
# Re-include the whole assets tree so prebuild never fails.
!assets/
!assets/**

# Expo doctor reports
expo-doctor-report*.txt
